class Solution:
    def levelOrder(self, root):
        if not root:
            return []

        q = [root]
        ans = []

        while q:
            level = []
            size = len(q)

            for i in range(size):
                node = q.pop(0)
                level.append(node.val)

                if node.left:
                    q.append(node.left)

                if node.right:
                    q.append(node.right)

            ans.append(level)

        return ans
