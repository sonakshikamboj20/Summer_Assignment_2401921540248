class Solution:
    def maxSlidingWindow(self, nums, k):
        q = []      # stores indices
        ans = []

        for i in range(len(nums)):

            # Remove indices out of current window
            while q and q[0] <= i - k:
                q.pop(0)

            # Remove smaller elements from the back
            while q and nums[q[-1]] < nums[i]:
                q.pop()

            q.append(i)

            # Add maximum for current window
            if i >= k - 1:
                ans.append(nums[q[0]])

        return ans
